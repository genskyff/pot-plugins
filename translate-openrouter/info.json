{
  "id": "plugin.translate_openrouter",
  "plugin_type": "translate",
  "icon": "icon.svg",
  "display": "OpenRouter",
  "homepage": "https://github.com/genskyff/pot-plugins",
  "needs": [
    {
      "key": "requestUrl",
      "display": "请求地址",
      "type": "input"
    },
    {
      "key": "apiKey",
      "display": "API Key*",
      "type": "input"
    },
    {
      "key": "model",
      "display": "模型",
      "type": "select",
      "options": {
        "openrouter/free": "openrouter/free",
        "openai/gpt-5.6-luna": "openai/gpt-5.6-luna",
        "anthropic/claude-sonnet-5": "anthropic/claude-sonnet-5",
        "x-ai/grok-4.6": "x-ai/grok-4.6",
        "google/gemini-3.6-flash": "google/gemini-3.6-flash",
        "custom": "自定义"
      }
    },
    {
      "key": "customModel",
      "display": "自定义模型",
      "type": "input"
    },
    {
      "key": "thinking",
      "display": "思考模式",
      "type": "select",
      "options": {
        "omit": "默认",
        "enabled": "开启",
        "disabled": "关闭"
      }
    },
    {
      "key": "reasoningEffort",
      "display": "推理强度",
      "type": "select",
      "options": {
        "omit": "默认",
        "none": "none",
        "minimal": "minimal",
        "low": "low",
        "medium": "medium",
        "high": "high",
        "xhigh": "xhigh",
        "max": "max"
      }
    },
    {
      "key": "customPrompt",
      "display": "自定义 Prompt",
      "type": "input"
    },
    {
      "key": "temperature",
      "display": "温度",
      "type": "input"
    },
    {
      "key": "extraBody",
      "display": "自定义请求体（JSON）",
      "type": "input"
    }
  ],
  "language": {
    "auto": "Auto",
    "zh_cn": "Simplified Chinese",
